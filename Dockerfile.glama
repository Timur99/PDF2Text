FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY backend/ ./backend/
RUN python -m pip install . && mkdir -p /documents

# Linux supports native PDF extraction. Apple Vision requires a macOS host.
USER 10001:10001
CMD ["pdf2text-mcp", "--allow-dir", "/documents"]
